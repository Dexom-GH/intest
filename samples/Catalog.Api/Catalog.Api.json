  "components": {
    "schemas": {
      "CategoryResponse": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateCategoryRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "type": "string"
          },
          "notes": {
            "maxLength": 1000,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateProductRequest": {
        "required": [
          "sku",
          "name",
          "price",
          "stockQuantity",
          "categoryId"
        ],
        "type": "object",
        "properties": {
          "sku": {
            "maxLength": 32,
            "pattern": "^[A-Z]{3}-[0-9]{4}$",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "type": [
              "null",
              "string"
            ]
          },
          "price": {
            "maximum": 1000000,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "stockQuantity": {
            "maximum": 2147483647,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "$ref": "#/components/schemas/ProductCategory"
          },
          "availableFrom": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "supplierEmail": {
            "maxLength": 320,
            "type": [
              "null",
              "string"
            ]
          },
          "dimensions": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DimensionsRequest"
              }
            ]
          },
          "tags": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DimensionsRequest": {
        "required": [
          "lengthCentimetres",
          "widthCentimetres",
          "heightCentimetres"
        ],
        "type": "object",
        "properties": {
          "lengthCentimetres": {
            "maximum": 10000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "widthCentimetres": {
            "maximum": 10000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "heightCentimetres": {
            "maximum": 10000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "DimensionsResponse": {
        "required": [
          "lengthCentimetres",
          "widthCentimetres",
          "heightCentimetres"
        ],
        "type": "object",
        "properties": {
          "lengthCentimetres": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "widthCentimetres": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "heightCentimetres": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
