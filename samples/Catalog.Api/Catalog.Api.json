            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$",
            "type": [
              "null",
              "string"
            ]
          },
          "thumbnail": {
            "type": [
              "null",
              "string"
            ],
            "format": "byte"
          },
          "productUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "supplierEmail": {
            "type": [
              "null",
              "string"
            ]
          },
          "parentProductId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "dimensions": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DimensionsResponse"
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductTagResponse"
            }
          }
        }
